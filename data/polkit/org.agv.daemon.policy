<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>agv-gui</vendor>
  <vendor_url>https://github.com/raitar239/agv-gui</vendor_url>

  <!-- Day-to-day use: like NetworkManager, the active local user needs no password -->
  <action id="org.agv.daemon.control">
    <description>Control the AdGuard VPN connection and exclusions</description>
    <message>Authentication is required to control AdGuard VPN</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Account and settings affect every user of the machine -->
  <action id="org.agv.daemon.configure">
    <description>Change AdGuard VPN account and settings</description>
    <message>Authentication is required to change AdGuard VPN settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
