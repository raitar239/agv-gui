# Maintainer: Raitar <raitar239 at gmail dot com>

pkgname=agv-gui
pkgver=0.2.0
pkgrel=1
pkgdesc='Unofficial client for AdGuard VPN CLI with per-app exclusions and a kill switch (Qt 6)'
arch=('x86_64' 'aarch64')
url='https://github.com/raitar239/agv-gui'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'nftables' 'iproute2' 'polkit' 'systemd')
makedepends=('cmake' 'ninja' 'qt6-tools')
optdepends=('adguardvpn-cli-bin: the AdGuard VPN CLI, unless installed with AdGuard'\''s script')
install=agv-gui.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # packaging/aur/update.sh fills this in for a release

build() {
    cmake -S "$pkgname-$pkgver" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib/agv-gui \
        -DBUILD_TESTING=ON
    cmake --build build
}

check() {
    # Tests needing a session bus or user namespaces skip themselves where those are missing.
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
