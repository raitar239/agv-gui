<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  agvd D-Bus API. System bus, object path /org/agv/Daemon.
  The bus name must be renamed to a namespace the project owns (e.g. io.github.<owner>.Agv)
  before the first release; only this file and src/common/dbustypes.h hardcode it.

  Authorization (polkit, see data/polkit/org.agv.daemon.policy):
    reads                                  - anyone allowed by the D-Bus policy
    org.agv.daemon.control                 - connect, disconnect, site and app exclusions, license
    org.agv.daemon.configure               - settings, login, logout, import, stopping external VPNs,
                                             app exclusion mode, startup settings

  Failed calls return org.agv.Error.* errors (NotLoggedIn, CliFailed, CliNotFound, Timeout,
  UnexpectedOutput, InvalidArgument, Busy, NotAuthorized, NotFound, NotSupported, SystemFailed).

  State changes are announced through org.freedesktop.DBus.Properties.PropertiesChanged.
-->
<node>
  <interface name="org.agv.Daemon1">

    <!-- Connection -->

    <!-- "unknown", "not-logged-in", "disconnected", "connecting", "connected", "disconnecting", "error" -->
    <property name="State" type="s" access="read"/>
    <!-- Location as reported by the CLI ("ATHENS"); empty when disconnected -->
    <property name="Location" type="s" access="read"/>
    <!-- "TUN" or "SOCKS"; empty when disconnected -->
    <property name="Mode" type="s" access="read"/>
    <!-- "tun0"; empty in SOCKS mode or when disconnected -->
    <property name="TunDevice" type="s" access="read"/>
    <!-- Human-readable reason of the last failure -->
    <property name="LastError" type="s" access="read"/>

    <!-- location: city, country or ISO code; empty string means the last used location -->
    <method name="Connect">
      <arg name="location" type="s" direction="in"/>
    </method>
    <method name="ConnectFastest"/>
    <method name="Disconnect"/>

    <!--
      VPN instances started outside agvd (another HOME, e.g. a user's own adguardvpn-cli):
      (pid, uid, home). Only reported while agvd itself is not connected; the GUI should offer
      StopExternalVpns before Connect.
    -->
    <property name="ExternalVpns" type="a(uus)" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="AgvExternalVpnList"/>
    </property>
    <method name="StopExternalVpns"/>

    <method name="ListLocations">
      <arg name="locations" type="a(sssi)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AgvLocationList"/>
    </method>

    <!-- Account -->

    <property name="LoggedIn" type="b" access="read"/>

    <!-- Starts device-code login; LoginUrl delivers the link to open in a browser -->
    <method name="Login"/>
    <method name="CancelLogin"/>
    <method name="Logout"/>
    <!-- Copies the caller's own adguardvpn-cli login and settings into agvd's data directory -->
    <method name="ImportLogin"/>
    <signal name="LoginUrl">
      <arg name="url" type="s"/>
    </signal>
    <signal name="LoginFinished">
      <arg name="success" type="b"/>
      <arg name="message" type="s"/>
    </signal>

    <!-- Keys: account (s), plan (s), max_devices (i), valid_until (s, ISO date) -->
    <method name="GetLicense">
      <arg name="license" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>

    <!-- Site exclusions (adguardvpn-cli site-exclusions) -->

    <!-- "general" or "selective" -->
    <property name="SiteExclusionMode" type="s" access="read"/>
    <method name="SetSiteExclusionMode">
      <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="GetSiteExclusions">
      <arg name="items" type="as" direction="out"/>
    </method>
    <!-- Active entries plus the ones switched off in AGV (kept by agvd, not in the CLI): (item, enabled) -->
    <method name="ListSiteExclusions">
      <arg name="items" type="a(sb)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AgvSiteExclusionList"/>
    </method>
    <!-- Off removes the entry from the CLI and remembers it; on adds it back. members (the entries
         shown under it, e.g. "*.a.com" under "a.com") go off with it and come back with it, except
         those already switched off on their own. -->
    <method name="SetSiteExclusionEnabled">
      <arg name="item" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
      <arg name="members" type="as" direction="in"/>
    </method>
    <!-- Only forms the CLI accepts: domain, www.domain, *.domain, IPv4[:port], IPv6, [IPv6][:port], CIDR -->
    <method name="AddSiteExclusions">
      <arg name="items" type="as" direction="in"/>
    </method>
    <method name="RemoveSiteExclusions">
      <arg name="items" type="as" direction="in"/>
    </method>
    <signal name="SiteExclusionsChanged"/>

    <!-- App exclusions (agvd's own engine: cgroup + nftables + policy routing) -->

    <!-- False when the kernel lacks cgroup v2 or nftables socket matching -->
    <property name="AppExclusionsSupported" type="b" access="read"/>

    <!--
      "bypass": the listed apps skip the VPN (default).
      "vpn-only": only the listed apps use the VPN; everything else goes straight out. Affects the
      whole system, so changing it needs org.agv.daemon.configure.
    -->
    <property name="AppExclusionMode" type="s" access="read"/>
    <method name="SetAppExclusionMode">
      <arg name="mode" type="s" direction="in"/>
    </method>

    <!--
      Rows: (id, rule) where rule keys are
        name (s), icon (s), desktop_file (s), exe (s), cmdline_match (s), enabled (b)
      Add/Update take the same keys; Update changes only the keys it is given. An enabled app
      gets its own cgroup; processes enter it through "agv-run [app option] ID cmd" now and
      through the exec watcher later. Removing or disabling an app moves its processes back
      through the VPN for new connections.
    -->
    <method name="ListAppExclusions">
      <arg name="exclusions" type="a(sa{sv})" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AgvAppExclusionList"/>
    </method>
    <method name="AddAppExclusion">
      <arg name="rule" type="a{sv}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QVariantMap"/>
      <arg name="id" type="s" direction="out"/>
    </method>
    <method name="UpdateAppExclusion">
      <arg name="id" type="s" direction="in"/>
      <arg name="rule" type="a{sv}" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In1" value="QVariantMap"/>
    </method>
    <method name="RemoveAppExclusion">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Per-app byte counters since the rules were last loaded: (id, bytes_out, bytes_in);
         the builtin agv-run group is reported as "run" -->
    <method name="GetAppTraffic">
      <arg name="traffic" type="a(stt)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AgvAppTrafficList"/>
    </method>
    <signal name="AppExclusionsChanged"/>

    <!-- Traffic and connection history as JSON: {days: {"yyyy-MM-dd": {in, out, seconds,
         connections, locations: {name: {in, out, seconds}}, apps: {id: {in, out}}}},
         hours: {epoch: {in, out, seconds}}, sessions: [{start, end, location, in, out, seconds}],
         current: {...}, apps: {id: {name, icon}}, since}. Only the caller's own apps. -->
    <method name="GetStatistics">
      <arg name="json" type="s" direction="out"/>
    </method>
    <method name="ResetStatistics"/>

    <!-- Startup (org.agv.daemon.configure) -->

    <!-- agvd.service starts at boot -->
    <property name="StartAtBoot" type="b" access="read"/>
    <method name="SetStartAtBoot">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <!-- Kill switch: while the VPN should be up (also while it reconnects after a drop) only the
         tunnel, agvd itself, excluded apps and optionally the local network get out -->
    <property name="KillSwitch" type="b" access="read"/>
    <method name="SetKillSwitch">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <property name="KillSwitchAllowLan" type="b" access="read"/>
    <method name="SetKillSwitchAllowLan">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <!-- While connected in TUN mode, send every program's plain DNS (port 53) through the tunnel,
         even where the system resolver points at the router -->
    <property name="KeepDnsInVpn" type="b" access="read"/>
    <method name="SetKeepDnsInVpn">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <!-- The VPN is down and the kill switch is holding traffic back right now -->
    <property name="KillSwitchActive" type="b" access="read"/>
    <!-- The VPN dropped and agvd is connecting again; Disconnect stops it -->
    <property name="Reconnecting" type="b" access="read"/>

    <!-- When agvd starts, connect to the last used location, retrying while the network comes up -->
    <property name="AutoConnect" type="b" access="read"/>
    <method name="SetAutoConnect">
      <arg name="enabled" type="b" direction="in"/>
    </method>

    <!-- Configuration (adguardvpn-cli config show / set-*) -->

    <!-- Keys are CLI labels ("Tunnel routing mode") -->
    <method name="GetConfig">
      <arg name="config" type="a{s(sb)}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AgvConfigMap"/>
    </method>
    <!-- key is a set-* subcommand without the prefix ("protocol", "dns", ...) -->
    <method name="SetConfig">
      <arg name="key" type="s" direction="in"/>
      <arg name="value" type="s" direction="in"/>
    </method>

  </interface>
</node>
