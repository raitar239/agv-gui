<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  agvd D-Bus API, draft. System bus, object path /org/agv/Daemon.
  The bus name must be renamed to a namespace the project owns (e.g. io.github.<owner>.Agv)
  before the first release; nothing outside this file and its generated code should hardcode it.

  Read-only calls are allowed for any local active session. Everything that changes state
  requires the polkit action org.agv.daemon.manage (auth_admin_keep by default).

  State changes are announced through org.freedesktop.DBus.Properties.PropertiesChanged.
-->
<node>
  <interface name="org.agv.Daemon1">

    <!-- Connection -->

    <!-- "disconnected", "connecting", "connected", "disconnecting", "error" -->
    <property name="State" type="s" access="read"/>
    <!-- Location as reported by the CLI ("ATHENS"); empty when disconnected -->
    <property name="Location" type="s" access="read"/>
    <!-- "TUN" or "SOCKS" -->
    <property name="Mode" type="s" access="read"/>
    <!-- "tun0"; empty in SOCKS mode or when disconnected -->
    <property name="TunDevice" type="s" access="read"/>
    <!-- Human-readable reason of the last failure; empty when State is not "error" -->
    <property name="LastError" type="s" access="read"/>

    <!-- location: city, country or ISO code; empty string means the last used location -->
    <method name="Connect">
      <arg name="location" type="s" direction="in"/>
    </method>
    <method name="ConnectFastest"/>
    <method name="Disconnect"/>

    <!-- Rows: (iso, country, city, ping_ms); ping_ms is -1 when unknown -->
    <method name="ListLocations">
      <arg name="locations" type="a(sssi)" direction="out"/>
    </method>

    <!-- Account -->

    <!-- Keys: account (s), plan (s), max_devices (i), valid_until (s, ISO date) -->
    <method name="GetLicense">
      <arg name="license" type="a{sv}" direction="out"/>
    </method>

    <!-- Site exclusions (adguardvpn-cli site-exclusions) -->

    <!-- "general" or "selective" -->
    <property name="SiteExclusionMode" type="s" access="read"/>
    <method name="SetSiteExclusionMode">
      <arg name="mode" type="s" direction="in"/>
    </method>
    <method name="GetSiteExclusions">
      <arg name="domains" type="as" direction="out"/>
    </method>
    <method name="AddSiteExclusions">
      <arg name="domains" type="as" direction="in"/>
    </method>
    <method name="RemoveSiteExclusions">
      <arg name="domains" type="as" direction="in"/>
    </method>
    <signal name="SiteExclusionsChanged"/>

    <!-- App exclusions (agvd's own engine: cgroup + nftables + policy routing) -->

    <!-- False when the kernel lacks cgroup v2 or nftables socket matching -->
    <property name="AppExclusionsSupported" type="b" access="read"/>

    <!--
      Rows: (id, rule) where rule keys are
        name (s), icon (s), desktop_file (s), exe (s), cmdline_match (s), enabled (b)
    -->
    <method name="ListAppExclusions">
      <arg name="exclusions" type="a(sa{sv})" direction="out"/>
    </method>
    <method name="AddAppExclusion">
      <arg name="rule" type="a{sv}" direction="in"/>
      <arg name="id" type="s" direction="out"/>
    </method>
    <method name="UpdateAppExclusion">
      <arg name="id" type="s" direction="in"/>
      <arg name="rule" type="a{sv}" direction="in"/>
    </method>
    <method name="RemoveAppExclusion">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Per-app traffic counters: (id, bytes_out, bytes_in) -->
    <method name="GetAppTraffic">
      <arg name="traffic" type="a(stt)" direction="out"/>
    </method>
    <signal name="AppExclusionsChanged"/>

    <!-- Configuration (adguardvpn-cli config show / set-*) -->

    <!-- Keys are CLI labels ("Tunnel routing mode"); value is (value, is_default) -->
    <method name="GetConfig">
      <arg name="config" type="a{s(sb)}" direction="out"/>
    </method>
    <!-- key is the set-* subcommand without the prefix ("protocol", "dns", ...) -->
    <method name="SetConfig">
      <arg name="key" type="s" direction="in"/>
      <arg name="value" type="s" direction="in"/>
    </method>

  </interface>
</node>
